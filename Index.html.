<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <title>Nährwert Tracker mit Verlauf</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="p-4 md:p-8 bg-slate-50 text-slate-900">
    <div class="max-w-md mx-auto">
        <div class="flex bg-white p-1 rounded-xl shadow-sm border border-slate-200 mb-6">
            <button onclick="setView('today')" id="btn-today" class="flex-1 py-2 rounded-lg font-semibold transition bg-slate-900 text-white">Heute</button>
            <button onclick="setView('history')" id="btn-history" class="flex-1 py-2 rounded-lg font-semibold transition text-slate-500">Verlauf</button>
        </div>

        <div id="view-today">
            <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200 mb-6">
                <h2 class="text-lg font-bold mb-4">Eintrag hinzufügen</h2>
                <div class="space-y-3">
                    <input id="desc" type="text" placeholder="Was gab es?" class="w-full border-slate-200 border p-2.5 rounded-lg focus:ring-2 focus:ring-blue-500 outline-none">
                    <div class="grid grid-cols-2 gap-3">
                        <input id="kcal" type="number" placeholder="kcal" class="border-slate-200 border p-2.5 rounded-lg outline-none">
                        <input id="prot" type="number" placeholder="Protein (g)" class="border-slate-200 border p-2.5 rounded-lg outline-none">
                    </div>
                    <button onclick="addFood()" class="w-full bg-blue-600 text-white font-semibold py-2.5 rounded-lg hover:bg-blue-700 transition">Hinzufügen</button>
                </div>
            </div>

            <div id="today-list" class="space-y-2 mb-6"></div>

            <div id="summary" class="p-4 bg-white rounded-xl border border-slate-200 shadow-sm">
                <div class="flex justify-between font-bold text-lg">
                    <span>Tagessumme:</span>
                    <span id="totalKcal">0 kcal</span>
                </div>
                <div class="text-sm text-slate-500" id="totalProt">Protein: 0g</div>
            </div>
        </div>

        <div id="view-history" class="hidden space-y-4">
            <h2 class="text-xl font-bold px-2">Deine Historie</h2>
            <div id="history-list" class="space-y-3"></div>
        </div>
    </div>

    <script>
        const getTodayKey = () => new Date().toISOString().split('T')[0];
        let currentView = 'today';

        function getDB() {
            return JSON.parse(localStorage.getItem('nutritionHistory')) || {};
        }

        function setView(view) {
            currentView = view;
            document.getElementById('view-today').classList.toggle('hidden', view !== 'today');
            document.getElementById('view-history').classList.toggle('hidden', view !== 'history');
            
            document.getElementById('btn-today').className = view === 'today' ? 'flex-1 py-2 rounded-lg font-semibold bg-slate-900 text-white' : 'flex-1 py-2 rounded-lg font-semibold text-slate-500';
            document.getElementById('btn-history').className = view === 'history' ? 'flex-1 py-2 rounded-lg font-semibold bg-slate-900 text-white' : 'flex-1 py-2 rounded-lg font-semibold text-slate-500';
            
            render();
        }

        function addFood() {
            const desc = document.getElementById('desc').value;
            const kcal = parseInt(document.getElementById('kcal').value) || 0;
            const prot = parseInt(document.getElementById('prot').value) || 0;
            if(!desc) return;

            const db = getDB();
            const key = getTodayKey();
            if (!db[key]) db[key] = [];
            
            db[key].push({ desc, kcal, prot });
            localStorage.setItem('nutritionHistory', JSON.stringify(db));
            
            document.getElementById('desc').value = '';
            document.getElementById('kcal').value = '';
            document.getElementById('prot').value = '';
            render();
        }

        function render() {
            const db = getDB();
            
            // Heute rendern
            const todayKey = getTodayKey();
            const todayData = db[todayKey] || [];
            const todayList = document.getElementById('today-list');
            todayList.innerHTML = todayData.map(item => `
                <div class="flex justify-between bg-white p-3 rounded-lg border border-slate-100 shadow-sm">
                    <span class="font-medium">${item.desc}</span>
                    <span class="text-slate-600">${item.kcal} kcal</span>
                </div>
            `).join('');

            const sumKcal = todayData.reduce((s, i) => s + i.kcal, 0);
            const sumProt = todayData.reduce((s, i) => s + i.prot, 0);
            document.getElementById('totalKcal').innerText = `${sumKcal} kcal`;
            document.getElementById('totalProt').innerText = `Protein: ${sumProt}g`;

            // Verlauf rendern
            const historyList = document.getElementById('history-list');
            const sortedKeys = Object.keys(db).sort().reverse(); // Neueste oben

            historyList.innerHTML = sortedKeys.map(key => {
                const daySumKcal = db[key].reduce((s, i) => s + i.kcal, 0);
                const daySumProt = db[key].reduce((s, i) => s + i.prot, 0);
                const formattedDate = new Date(key).toLocaleDateString('de-DE', { weekday: 'short', day: '2-digit', month: '2-digit' });
                
                return `
                    <div class="bg-white p-4 rounded-xl border border-slate-200 shadow-sm flex justify-between items-center">
                        <div>
                            <div class="text-xs font-bold uppercase text-slate-400 tracking-wider">${formattedDate}</div>
                            <div class="text-lg font-bold text-slate-800">${daySumKcal} kcal</div>
                        </div>
                        <div class="text-right text-sm text-slate-500">
                            ${daySumProt}g Protein<br>
                            ${db[key].length} Einträge
                        </div>
                    </div>
                `;
            }).join('');
        }

        render();
    </script>
</body>
</html>
